# CyberAlertX environment template. Copy to `.env` in the repository root for
# local development (`cp .env.example .env`); the code loads it automatically.
# Names only — never commit real values. Production keeps its own `.env`
# (mode 600) outside any release; load it in a shell with
# `ops/release/loadenv.sh`, never `source .env`.
#
# Everything is optional for local development: with this file as-is the
# backend runs JSON-only, renders with the deterministic rule-based writer
# (no AI calls) and publishes nowhere.

# --- Storage --------------------------------------------------------------------
# json (default): data/*.json only. dual: JSON authoritative + Postgres mirror.
CYBERALERTX_STORAGE_BACKEND=json
# Required only for dual. postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
CYBERALERTX_PG_URL=
# Seconds to establish a Postgres connection (default 10; 0 = libpq default).
# CYBERALERTX_PG_CONNECT_TIMEOUT_S=10
# How often the API refreshes its Postgres key index in dual mode (default 60).
# CYBERALERTX_PG_INDEX_TTL_SECONDS=60

# --- Ingest ---------------------------------------------------------------------
# Optional proxy prefix for feeds that refuse direct fetches (target URL is
# appended URL-encoded), e.g. https://<worker>.workers.dev/?u=
CYBERALERTX_RSS_PROXY_URL=
# Identifiable User-Agent for feed requests (default "CyberAlertX/1.0 (+https://cyberalertx.com)").
# CYBERALERTX_UA=
# CYBERALERTX_INTERVAL_MIN=15
# CYBERALERTX_MAX_ITEMS=200

# --- AI rendering (only with `generate --use-llm`) ------------------------------
# claude_cli (default: local `claude` CLI login) | anthropic (needs ANTHROPIC_API_KEY)
# CYBERALERTX_AI_PROVIDER=claude_cli
ANTHROPIC_API_KEY=

# --- Editorial review -----------------------------------------------------------
# off | flag (default: problems listed in /admin/review, posts stay visible) | hold
# Production runs flag; see docs/editorial/EDITORIAL_REVIEW_PROCESS.md before changing.
# CYBERALERTX_REVIEW_MODE=flag

# --- Admin ----------------------------------------------------------------------
# HTTP Basic password for /admin, at least 24 characters (openssl rand -hex 32).
# Unset or shorter = /admin answers 503 (disabled).
CYBERALERTX_ADMIN_TOKEN=

# --- Publishing (OFF unless explicitly configured and authorized) ---------------
# Telegram: no bot token = nothing is sent. Production keeps the publisher held.
CYBERALERTX_TELEGRAM_BOT_TOKEN=
CYBERALERTX_TELEGRAM_CHANNEL_EN=
CYBERALERTX_TELEGRAM_CHANNEL_UA=
# Threads: 0 = never publish. Setup: docs/threads/THREADS_SETUP.md
CYBERALERTX_THREADS_PUBLISH=0

# --- Public URLs ----------------------------------------------------------------
# CYBERALERTX_PUBLIC_BASE_URL=https://cyberalertx.com
