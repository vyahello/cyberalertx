# Installed as /etc/systemd/system/cyberalertx-frontend.service (source of truth: this file).
# Runs from the active immutable release via /home/cax/cyberalertx/current
# (docs/operations/OPERATIONS.md). Matches the host as of 5 Nov 2026.

[Unit]
Description=CyberAlertX Next.js frontend
After=network.target cyberalertx-api.service

[Service]
Type=simple
User=cax
Group=cax
WorkingDirectory=/home/cax/cyberalertx/current/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
