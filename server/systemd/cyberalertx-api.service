# Installed as /etc/systemd/system/cyberalertx-api.service (source of truth: this file).
# Runs from the active immutable release via /home/cax/cyberalertx/current
# (docs/operations/OPERATIONS.md). Matches the host as of 5 Nov 2026.

[Unit]
Description=CyberAlertX FastAPI server
After=network.target

[Service]
Type=simple
User=cax
Group=cax
WorkingDirectory=/home/cax/cyberalertx/current
EnvironmentFile=/home/cax/cax/.env
ExecStart=/home/cax/cyberalertx/current/venv/bin/python -m cyberalertx.main serve --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
