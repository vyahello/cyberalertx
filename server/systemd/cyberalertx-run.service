# Installed as /etc/systemd/system/cyberalertx-run.service (source of truth: this file).
# Runs from the active immutable release via /home/cax/cyberalertx/current
# (docs/operations/OPERATIONS.md). Matches the host as of 5 Nov 2026.

[Unit]
Description=CyberAlertX ingest scheduler (RSS fetch every 30 min)
After=network.target

[Service]
Type=simple
User=cax
Group=cax
WorkingDirectory=/home/cax/cyberalertx/current
EnvironmentFile=/home/cax/cax/.env
ExecStart=/home/cax/cyberalertx/current/venv/bin/python -m cyberalertx.main run --interval 30
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
