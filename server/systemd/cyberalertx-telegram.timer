# /etc/systemd/system/cyberalertx-telegram.timer
#
# Fires cyberalertx-telegram.service at minute :15 on ten hours of the day,
# 15 minutes after the generate timer ticks at :00. The offset lets
# cyberalertx-generate finish rendering before publish.
#
# The slot COUNT is the daily volume control. `--limit 1` in the service is
# per CHANNEL, not per story, so each fire sends one message to @cyberalertx_en
# and one to @cyberalertx_ua. Ten slots therefore means:
#
#     10 stories/day  ->  10 EN + 10 UA  =  20 messages/day
#
# Change the number of slots to change the volume; do not raise `--limit`
# instead, which would post several stories back-to-back in one burst.
#
# Which two hours are missing: 02:15 and 04:15. The audience is largely in
# Kyiv (see DEFAULT_TZ in server/analytics), and those are its deadest hours,
# so they are the cheapest slots to give up. 00:15 and 06:15 are kept
# deliberately — late-night and early-commute reading are real.
#
# Site posting (cyberalertx-generate) is unaffected — still hourly. Note that
# the site ingests ~18 stories/day, so at 10/day the channels publish roughly
# half of what the site carries, and the surplus ages out of the 200-item
# store unpublished. That is a deliberate volume choice, not a fault.
#
# Persistent=true: if the VPS was off when a fire was due, systemd runs it as
# soon as the box is back up (the ledger prevents double-posting).
#
# RandomizedDelaySec=120: small jitter so fleet timers don't all hit the
# Telegram API at the same wall-clock second.

[Unit]
Description=CyberAlertX Telegram publish timer (10x/day, +15m after generate)
Requires=cyberalertx-telegram.service

[Timer]
OnCalendar=*-*-* 00,06,08,10,12,14,16,18,20,22:15:00
Persistent=true
RandomizedDelaySec=120
Unit=cyberalertx-telegram.service

[Install]
WantedBy=timers.target
