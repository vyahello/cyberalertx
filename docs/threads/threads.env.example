# Threads integration — PLACEHOLDERS ONLY. Copy the lines you need into the
# server's .env (EnvironmentFile of the systemd units). Never commit real values.

# Meta App Dashboard → your app → Use cases → Access the Threads API → Settings
CYBERALERTX_THREADS_APP_ID=000000000000000
CYBERALERTX_THREADS_APP_SECRET=replace-with-threads-app-secret

# Must match a "Redirect Callback URL" in the app exactly (scheme, host, path, slash).
CYBERALERTX_THREADS_REDIRECT_URI=https://cyberalertx.com/admin/threads/callback

# Encrypts stored tokens. Generate with:  python -m cyberalertx.tools.threads gen-key
# Changing or losing it means reconnecting every account.
CYBERALERTX_THREADS_TOKEN_KEY=replace-with-generated-fernet-key

# slot:locale pairs. One profile per language; "uk" is accepted for Ukrainian.
CYBERALERTX_THREADS_ACCOUNTS=en:en,ua:ua

# Publishing stays OFF until you explicitly enable it (after both accounts verify).
CYBERALERTX_THREADS_PUBLISH=0

# Optional: severity bar (like Telegram) and posts per account per timer run.
# CYBERALERTX_THREADS_MIN_LEVEL=High
# CYBERALERTX_THREADS_LIMIT=1
